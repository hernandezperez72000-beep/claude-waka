# En uploads nunca se ejecuta código: solo se sirven imágenes
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .phar .cgi .pl
# php_flag solo existe con mod_php. En cPanel con PHP-FPM o lsphp (lo normal)
# una directiva desconocida devuelve 500 y dejaría de servirse ni una sola foto.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|phar|cgi|pl|htaccess)$">
  Require all denied
</FilesMatch>
